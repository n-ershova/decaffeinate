REPO=memory
# Allowed frontend origins for credentialed requests. Use HTTPS and COOKIE_SECURE=1 when deployed.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=0
DATABASE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Ticket D2 defaults to six seconds; increase locally for slower responses.
GEMINI_TIMEOUT_SECONDS=6

HALFLIFE_TIMEZONE=Europe/London
HALFLIFE_API=http://127.0.0.1:8000
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_multilingual_v2
PRESAGE_API_KEY=
# Optional absolute Node.js executable if node is not on PATH.
PRESAGE_NODE=

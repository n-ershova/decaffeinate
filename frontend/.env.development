# Shared `npm run dev` defaults, so a fresh clone works. Override in .env.local (ignored).
# Real backend, but /state, /profile, /whatif and /brief are built from fixtures until
# the M2–M7 model tickets land; flip NEXT_PUBLIC_MOCK_MODEL to 0 then.
NEXT_PUBLIC_MOCK=0
NEXT_PUBLIC_LIVE_IDENTIFY=1
NEXT_PUBLIC_MOCK_MODEL=1
